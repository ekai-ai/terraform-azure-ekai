# Local .terraform directories (provider plugins, module cache)
**/.terraform/*
.terraform.lock.hcl

# State files (this repo uses a remote azurerm backend — local state should
# never exist, but ignore it defensively anyway)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Generated per-env backend config (regenerate with scripts/init-state-backend.sh)
env/backend-*.tfbackend

# scripts/self-deploy.sh output — generated passwords/client secrets, never commit
.self-deploy/

# Override files (local-only resource overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# tfplan output (terraform plan -out=tfplan)
*.tfplan

.DS_Store

# Only customer.tfvars (the template, no real values) is tracked. Every
# env/<name>.tfvars created from it is local-only and gitignored.
env/*.tfvars
!env/customer.tfvars
