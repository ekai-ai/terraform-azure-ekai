# ──────────────────────────────────────────────────────────────────────────────
# Root module — composes 3 of the 4 submodules (bootstrap, cluster, platform)
# that used to be 4 separate root modules in devops/azure-terraform
# (01-bootstrap/02-cluster/03-platform/04-cicd), each chained via
# `data "terraform_remote_state"` with its own azurerm backend/state. Now:
# one apply, one state for these 3; module outputs wire submodule-to-submodule
# directly instead of remote-state reads.
#
# The 4th submodule (cicd) is deliberately NOT included here — it stays a
# separate apply/state at ./cicd/, reading THIS config's outputs via
# `data "terraform_remote_state"` (see ./cicd/main.tf). Unlike
# terraform-aws-ekai (which splits cicd out because the argocd provider's
# `password` field can't be configured from a same-apply resource attribute),
# Azure's argocd provider already used `port_forward_with_namespace` +
# `password` read from the platform layer's own output even in the original
# 4-layer design — so the same constraint applies here for the same reason:
# the ArgoCD admin password (self-service: freshly generated by
# module.platform in THIS apply) can only be fed into the argocd provider via
# a value Terraform already knows before apply, i.e. a remote_state read
# against an already-completed apply, never a same-apply resource attribute.
#
# Apply order matches the original layer order (bootstrap → cluster →
# platform); depends_on on each module block enforces it explicitly since
# Terraform can't always infer full ordering from the module.X.Y references
# alone (some resources inside a submodule -- the kubernetes/helm/kubectl-
# backed ones -- don't reference upstream outputs directly; they rely on the
# *provider* configuration at root already pointing at a live cluster).
# ──────────────────────────────────────────────────────────────────────────────

locals {
  # Derived from env_name unless explicitly overridden -- so two self-service
  # deployments never collide on the same Key Vault secret name. Must match
  # ./cicd/main.tf's own derivation of the same value exactly (cicd is a
  # separate apply/state and reads this secret too).
  secrets_name = coalesce(var.secrets_name, "ekai-${var.env_name}")

  # Key Vault names are globally unique across ALL of Azure and capped at 24
  # chars, start with a letter, end with a letter or digit, no consecutive
  # hyphens. Folding in the subscription ID (not just env_name) means two
  # different self-service subscriptions using the same env_name never
  # collide -- env_name alone isn't enough (unlike secrets_name/tls_name,
  # which are scoped to one vault/one DNS zone and so only need to be unique
  # within THIS deployment). The subscription ID's own hyphens are stripped
  # before truncating -- substr() on the raw UUID could cut right after one
  # of its hyphens depending on env_name's length, producing a name ending
  # in "-" (invalid) or a double hyphen, neither of which is obvious from
  # one single env_name's test run alone.
  key_vault_name = coalesce(var.key_vault_name, substr("ekai-${var.env_name}-${replace(data.azurerm_client_config.current.subscription_id, "-", "")}", 0, 24))

  tls_name            = coalesce(var.tls_name, "${var.env_name}-ekai-wildcard-tls")
  argocd_ingress_host = coalesce(var.argocd_ingress_host, "argocd.${var.dns_zone}")
  minio_host          = coalesce(var.minio_host, "minio.${var.dns_zone}")
}

data "azurerm_client_config" "current" {}

module "bootstrap" {
  source = "./modules/bootstrap"

  env_name            = var.env_name
  region              = var.region
  resource_group_name = var.resource_group_name
  dns_zone            = var.dns_zone
  manage_dns_zone     = var.manage_dns_zone
  rbac_principal_ids  = var.rbac_principal_ids
  tags                = var.tags
}

module "cluster" {
  source     = "./modules/cluster"
  depends_on = [module.bootstrap]

  region                              = var.region
  env_name                            = var.env_name
  resource_group_name                 = var.resource_group_name
  vnet_cidr                           = var.vnet_cidr
  pub_sub_1_a_cidr                    = var.pub_sub_1_a_cidr
  pri_sub_1_cidr                      = var.pri_sub_1_cidr
  pri_sub_2_cidr                      = var.pri_sub_2_cidr
  pri_sub_3_cidr                      = var.pri_sub_3_cidr
  cluster_name                        = var.cluster_name
  cluster_version                     = var.cluster_version
  sku_tier                            = var.sku_tier
  zones                               = var.zones
  node_count                          = var.node_count
  vm_size                             = var.vm_size
  system_node_pool_min_count          = var.system_node_pool_min_count
  system_node_pool_max_count          = var.system_node_pool_max_count
  app_vm_size                         = var.app_vm_size
  app_node_pool_min_count             = var.app_node_pool_min_count
  app_node_pool_max_count             = var.app_node_pool_max_count
  log_analytics_workspace_name        = var.log_analytics_workspace_name
  solution_plan_map                   = var.solution_plan_map
  postgresql_version                  = var.postgresql_version
  postgres_flexible_server_sku_name   = var.postgres_flexible_server_sku_name
  postgres_flexible_server_storage_mb = var.postgres_flexible_server_storage_mb
  enable_ha                           = var.enable_ha
  geo_redundant_backup_enabled        = var.geo_redundant_backup_enabled
  key_vault_name                      = local.key_vault_name
  secrets_name                        = local.secrets_name
  rbac_principal_ids                  = var.rbac_principal_ids
  cicd_provider                       = var.cicd_provider
  dns_zone                            = var.dns_zone
  create_acr                          = var.create_acr
  existing_acr_name                   = var.existing_acr_name
  tags                                = var.tags
}

module "platform" {
  source     = "./modules/platform"
  depends_on = [module.cluster]

  subscription_id              = var.subscription_id
  env_name                     = var.env_name
  resource_group_name          = var.resource_group_name
  region                       = var.region
  secrets_name                 = local.secrets_name
  cicd_provider                = var.cicd_provider
  namespace                    = var.namespace
  argocd_namespace             = var.argocd_namespace
  argocd_admin_password_hashed = var.argocd_admin_password_hashed
  argocd_ingress_host          = local.argocd_ingress_host
  dns_zone                     = var.dns_zone
  tls_name                     = local.tls_name
  acme_email                   = var.acme_email
  cluster_issuer_name          = var.cluster_issuer_name
  redis_namespace              = var.redis_namespace
  redis_chart_version          = var.redis_chart_version
  reloader_chart_version       = var.reloader_chart_version
  eso_chart_version            = var.eso_chart_version
  redis_replica_count          = var.redis_replica_count
  redis_persistence_size       = var.redis_persistence_size
  redis_storage_class          = var.redis_storage_class
  redis_metrics_enabled        = var.redis_metrics_enabled
  redis_network_policy_enabled = var.redis_network_policy_enabled
  neo4j_namespace              = var.neo4j_namespace
  neo4j_chart_version          = var.neo4j_chart_version
  neo4j_storage_size           = var.neo4j_storage_size
  neo4j_storage_class          = var.neo4j_storage_class
  neo4j_memory_request         = var.neo4j_memory_request
  neo4j_memory_limit           = var.neo4j_memory_limit
  neo4j_cpu_request            = var.neo4j_cpu_request
  neo4j_cpu_limit              = var.neo4j_cpu_limit
  minio_namespace              = var.minio_namespace
  minio_chart_version          = var.minio_chart_version
  minio_persistence_size       = var.minio_persistence_size
  minio_storage_class          = var.minio_storage_class
  minio_replicas               = var.minio_replicas
  minio_mode                   = var.minio_mode
  minio_default_buckets        = var.minio_default_buckets
  minio_host                   = local.minio_host
  minio_enable_ingress         = var.minio_enable_ingress
  minio_resources              = var.minio_resources
  secret_value_overrides       = var.secret_value_overrides
  tags                         = var.tags

  # formerly `data "terraform_remote_state" "cluster"` in 03-platform/main.tf
  key_vault_id                = module.cluster.key_vault_id
  key_vault_name              = module.cluster.key_vault_name
  tenant_id                   = module.cluster.tenant_id
  eso_app_client_id           = module.cluster.eso_app_client_id
  cert_manager_uami_client_id = module.cluster.cert_manager_uami_client_id
  acr_login_server            = module.cluster.acr_login_server
  mirrored_image_tags         = module.cluster.mirrored_image_tags
  postgres_fqdn               = module.cluster.postgres_fqdn
  backend_db_username         = module.cluster.backend_db_username
  backend_db_password         = module.cluster.backend_db_password
  backend_db_name             = module.cluster.backend_db_name
}
